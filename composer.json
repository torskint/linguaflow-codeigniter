{
	"name": "torskint/linguaflow-codeigniter",
	"description": "Linguaflow pour CodeIgniter 4 : client autonome du Translation Hub (app/Language, spark, webhook signé).",
	"type": "library",
	"license": "proprietary",
	"require": {
		"php": ">=8.1",
		"ext-curl": "*",
		"ext-json": "*",
		"ext-pdo": "*",
		"ext-pdo_sqlite": "*",
		"ext-zip": "*",
		"codeigniter4/framework": "^4.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"autoload": {
		"psr-4": {
			"Torskint\\LinguaFlowCi\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Torskint\\LinguaFlowCi\\Tests\\": "tests/"
		}
	}
}
